Geometry = GenFormat {
    12  C
    C  H
    1 1      0.00000000      0.41727209      1.34035331
    2 1      0.00000000      1.36277581      0.31264346
    3 1      0.00000000      0.94549248     -1.02003049
    4 1      0.00000000     -0.41727209     -1.32501204
    5 1      0.00000000     -1.36277581     -0.29730219
    6 1      0.00000000     -0.94549248      1.03537176
    7 2      0.00000000      0.74550740      2.38862741
    8 2      0.00000000      2.43471932      0.55254238
    9 2      0.00000000      1.68922144     -1.82842183
    10 2      0.00000000     -0.74550739     -2.37328614
    11 2      0.00000000     -2.43471932     -0.53720110
    12 2      0.00000000     -1.68922144      1.84376309
}

Driver = {}

Hamiltonian = DFTB {
    SCC = Yes
    SCCTolerance = 1.0E-10 # abnormally tight tolerance used for accuracy
    MaxAngularMomentum = {
        C = "p"
        H = "s"
    }
    Charge = 0.0
    Filling = Fermi {
        Temperature [Kelvin] = 273.15
    }
    SlaterKosterFiles = Type2FileNames {
        Prefix = {slakos/origin/mio-1-1/}
        Separator = "-"
        Suffix = ".skf"
    }
    Differentiation = FiniteDiff {}
}

Options = {
    WriteAutotestTag = Yes
}

InputVersion = 20.1

# Probe stage: restart the pumped state and apply a kick, with the ions still
# moving. The restarted geometry differs from the one in the input file above,
# so H0/S must be rebuilt for the restarted coordinates before the leapfrog
# propagator is bootstrapped. If they are not, the bootstrap Hamiltonian is
# evaluated at the input geometry instead, which leaves rho and rhoOld mutually
# inconsistent and excites the 2*dt leapfrog mode in the dipole.
ElectronDynamics = {
    Steps = 50
    TimeStep [au] = 0.2
    Perturbation = Kick {
        PolarizationDirection = "x"
    }
    FieldStrength [v/a] = 0.01
    IonDynamics = Yes
    InitialTemperature [K] = 273.15
    Probe = Yes
    WriteRestart = No
}
