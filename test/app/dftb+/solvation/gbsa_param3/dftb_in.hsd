Geometry = xyzFormat {
 <<< "struc.xyz"
}

Driver {}

Hamiltonian = DFTB {
  Solvation = GeneralisedBorn { # GFN2-xTB/GBSA(dmso)
    ParamFile = "param_gbsa_dmso.txt"
    State = "reference"
    Temperature [K] = 273.15
    Descreening {
      Defaults { D = 0.80920878 }
    }
    Radii {
      VanDerWaalsRadiiD3 { D = 0.604712316345255 }
    }
    SASA {
      Radii {
        VanDerWaalsRadiiD3 { D = 0.604712316345255 }
      }
      SurfaceTension {
        Defaults { D =  -1.268284850000000E+00 }
      }
    }
    HBondCorr = No
  }
  SCC = Yes
  SccTolerance = 1e-10
  MaxAngularMomentum {
    D = "s"
    C = "p"
    O = "p"
    N = "p"
  }
  SlaterKosterFiles = {
    C-C = "slakos/origin/mio-1-1/C-C.skf"
    C-D = "slakos/origin/mio-1-1/C-H.skf"
    C-N = "slakos/origin/mio-1-1/C-N.skf"
    C-O = "slakos/origin/mio-1-1/C-O.skf"
    D-C = "slakos/origin/mio-1-1/H-C.skf"
    D-D = "slakos/origin/mio-1-1/H-H.skf"
    D-N = "slakos/origin/mio-1-1/H-N.skf"
    D-O = "slakos/origin/mio-1-1/H-O.skf"
    N-C = "slakos/origin/mio-1-1/N-C.skf"
    N-D = "slakos/origin/mio-1-1/N-H.skf"
    N-N = "slakos/origin/mio-1-1/N-N.skf"
    N-O = "slakos/origin/mio-1-1/N-O.skf"
    O-C = "slakos/origin/mio-1-1/O-C.skf"
    O-D = "slakos/origin/mio-1-1/O-H.skf"
    O-N = "slakos/origin/mio-1-1/O-N.skf"
    O-O = "slakos/origin/mio-1-1/O-O.skf"
  }
}

Options {
  WriteAutotestTag = Yes
}

Analysis {
  CalculateForces = Yes
}

ParserOptions {
  ParserVersion = 8
}

Parallel {
  UseOmpThreads = Yes
}
